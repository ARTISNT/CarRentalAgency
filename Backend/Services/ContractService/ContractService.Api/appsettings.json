{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InternalJwt": {
    "Issuer": "InternalServices",
    "Audience": "Microservices",
    "ExpireMinutes": 60
  }, 
  "Storage": {
    "ContractsPath": "/data/contracts"
  },
  "ContractCertificate": {
    "Pfx"  : "/data/contracts/Certificates/contract_sign.pfx",
    "Password": "",
    "Certificate":  "/data/contracts/Certificates/certificate.crt" 
  }
}
