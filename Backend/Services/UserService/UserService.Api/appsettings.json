{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MessageBroker": {
    "Host":  "http://localhost:15672/",
    "UserName": "user",
    "Password": "password"
  },
  "UserJwt": {
    "Issuer": "UserService",
    "Audience": "UserService",
    "ExpireMinutes": 60
  },
  "InternalJwt": {
    "Issuer": "InternalServices",
    "Audience": "Microservices",
    "ExpireMinutes": 60
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 5,
    "LockMinutes": 5
  }
}
