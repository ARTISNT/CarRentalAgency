{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MessageBroker": {
    "Host": "rabbitmq",
    "Port": 5672
  },
  "InternalJwt": {
    "Issuer": "InternalServices",
    "Audience": "Microservices",
    "ExpireMinutes": 60
  } 
}
