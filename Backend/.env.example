# Local development defaults
# Copy to .env and adjust for your environment.
# Real secrets MUST NOT be committed.

MSSQL_PASSWORD=YourStrongPassword123!
InternalJWT_KEY=ChangeMe_InternalKey_Use_64+_Random_Chars
InternalJWT_ISSUER=InternalServices
InternalJWT_AUDIENCE=Microservices

UserJWT_KEY=ChangeMe_UserKey_Use_64+_Random_Chars
UserJWT_ISSUER=UserService
UserJWT_AUDIENCE=UserService
ContractCertificate_PASSWORD=ChangeMe_CertPassword
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=ChangeMe_RabbitPassword

# MailHog in docker-compose network (dev only)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@carrental.local
SMTP_FROM_NAME=Car Rental Agency
SMTP_TO_ADDRESS=noreply@carrental.local

EMAIL_VERIFICATION_SECRET=ChangeMe_EmailSecret_64+_Random_Chars
APP_VERIFICATION_URL=http://localhost:5173/api/User/verify-email
APP_FRONTEND_BASE_URL=http://localhost:5173

# BePaid (test mode by default; set real values only in production)
BEPAID_SHOP_ID=4225
BEPAID_SECRET_KEY=3834fbef1fe6ea024ef77f5c79ec7ff1ba710ea6241c08c2f341afda8af4c1c4
BEPAID_CALLBACK_URL=http://localhost:5173/payment/callback
BEPAID_NOTIFICATION_URL=https://your-ngrok-url.ngrok-free.dev/api/payments/webhook
# Optional. When set, webhook requires X-BePaid-Signature: HMAC-SHA256(body) hex.
BEPAID_WEBHOOK_SECRET=
